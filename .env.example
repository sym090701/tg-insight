TG_API_ID=
TG_API_HASH=
TG_BOT_TOKEN=
TG_PHONE=

# Optional fixed sources. Leave blank to choose joined groups from /groups after login.
# Comma-separated @usernames, public links resolvable by Telegram, or numeric IDs.
TG_SOURCE_CHATS=
TG_SUMMARY_TARGET=
TG_ALLOWED_USER_IDS=

LLM_API_KEY=
# Primary model used for chat analysis and summaries.
LLM_MODEL=
# Optional fallback used only when the primary model has a transient availability error.
LLM_FALLBACK_MODEL=
# Leave blank for OpenAI, or set an HTTPS OpenAI-compatible API endpoint.
LLM_BASE_URL=

# Fixed UTC+8 timezone for summary schedules.
TZ=Asia/Shanghai
SUMMARY_HOUR=21
SUMMARY_MINUTE=0
BACKFILL_DAYS=30
BACKFILL_MAX_MESSAGES=20000
RETENTION_DAYS=730
# Keep the archive below 10 GiB; this message count is a secondary safety bound.
ARCHIVE_MAX_MESSAGES=10000000
ARCHIVE_MAX_GB=10
ARCHIVE_MIN_FREE_MB=1024
QUERY_MAX_SOURCES=40
SUMMARY_MAX_MESSAGES=500
SUMMARY_MAX_CHARS=120000
SUMMARY_MAX_ATTEMPTS=3
DATA_DIR=/data
LOG_LEVEL=INFO
